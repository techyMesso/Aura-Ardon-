{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "auto-cancel-pending": {
      "schedule": "0 * * * *",
      "path": "/api/cron/auto-cancel-pending",
      "requestMethod": "GET"
    },
    "daily-summary": {
      "schedule": "0 17 * * *",
      "path": "/api/cron/daily-summary",
      "requestMethod": "GET"
    },
    "prune-events": {
      "schedule": "0 2 * * 0",
      "path": "/api/cron/prune-events",
      "requestMethod": "GET"
    }
  }
}

