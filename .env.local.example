# Copy to .env.local and fill in STAGING values for local development.
# NEVER put production Supabase keys in .env.local or Vercel Preview environments.
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
LOG_LEVEL=debug
APP_ENV=development

# Required secrets (server-only)
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-supabase-service-role-key
ADMIN_EMAIL=aura.ardoncompany@gmail.com
ORDER_STATUS_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional server secrets (recommended in production)
REVALIDATE_SECRET=replace-with-a-long-random-revalidate-secret
CRON_SECRET=replace-with-a-long-random-cron-secret

# Public configuration
# Production: https://aura-ardon.vercel.app (or your custom domain later)
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://scukquqkdivnodefqggf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-supabase-anon-key
NEXT_PUBLIC_WHATSAPP_NUMBER=254718038825

# Optional distributed rate limiting (Upstash Redis — skipped in local dev when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional email notifications (Phase 10)
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=

# Optional observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
