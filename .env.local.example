# Copy to .env.local and fill in real values for local development.
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
LOG_LEVEL=debug
APP_ENV=development

# Required secrets (server-only)
ORDER_STATUS_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars
REVALIDATE_SECRET=replace-with-a-long-random-revalidate-secret
ADMIN_EMAIL=aura.ardoncompany@gmail.com
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Public configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000

# Optional distributed rate limiting (Upstash Redis — skipped in local dev when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

